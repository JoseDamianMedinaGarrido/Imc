<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Imc.Maui.Views.MainPage"
             Title="Índice de masa corporal">

    <VerticalStackLayout
        Padding="24"
        Spacing="24">
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                
                <Label
                    Text="Proporcione el texto en kilogramos:"/>
                <Entry
                    BackgroundColor="WhiteSmoke"
                    Text="{Binding Path=Peso}"
                    TextColor="Black"/>
                <Label
                    Text="Proporcione la estatura en metros"/>
                <Entry
                    BackgroundColor="WhiteSmoke"
                    Text="{Binding Path=Estatura}"
                    TextColor="Black"/>
            </VerticalStackLayout>
        </Border>
        <HorizontalStackLayout
            Spacing="24"
            HorizontalOptions="Center">
            <Button
                Text="Calcular"
                BackgroundColor="Green"
                Command="{Binding Path=CalcularCommand}"/>
            <Button
                Text="Limpiar"
                Command="{Binding Path=LimpiarCommand}"/>
        </HorizontalStackLayout>
        <Border>
            <VerticalStackLayout
                Padding="18"
                Spacing="8">
                <Label
                    Text=" El índice de masa corporal de la persona es:"/>
                <Label
                    Text="{Binding Path=Imc}"
                    HorizontalOptions="Center"
                    FontSize="Medium"
                    FontAttributes="Bold"
                    />
                <Label
                    Text="El estado nutricional de la persona es:"/>
                <Label
                    Text="{Binding Path=EstadoNutricional}"
                    HorizontalOptions="Center"
                    FontSize="Medium"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>